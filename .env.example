# HTTP
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://wagering:wagering@localhost:5439/wagering
DB_POOL_MIN=2
DB_POOL_MAX=10
# MIKRO_ORM_DEBUG=true   # log every SQL statement

# SQS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-events.fifo
CONSUMER_NAME=wager-consumer

# SQS consumer
SQS_CONSUMER_ENABLED=true
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=5
SQS_RETRY_BACKOFF_BASE_SECONDS=2
SQS_CONSUMER_BATCH_SIZE=10

# Outbox relay
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# Pending-reference worker (out-of-order REFUND/ROLLBACK)
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_CAP_DELAY_MS=300000
