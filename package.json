{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:http": "WORKERS_ENABLED=false bun run src/main.ts",
    "worker": "bun run src/worker.ts",
    "test": "bun test src test/integration test/concurrency",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:multi-instance": "bun test test/multi-instance",
    "test:all": "bun run test && bun run test:multi-instance",
    "db:up": "bun run scripts/db.ts up",
    "db:down": "bun run scripts/db.ts down",
    "db:fresh": "bun run scripts/db.ts fresh",
    "db:pending": "bun run scripts/db.ts pending",
    "migration:create": "mikro-orm migration:create",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.658.0",
    "@mikro-orm/cli": "^6.4.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/terminus": "^10.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@types/bun": "^1.1.10",
    "@types/express": "^4.17.21",
    "typescript": "^5.6.2"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/infra/database/mikro-orm.config.ts"
    ]
  }
}
